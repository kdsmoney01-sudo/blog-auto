# 블로그 자동 수익 시스템 환경변수
# 실제 사용 = .env 로 복사 후 채움. git 커밋 X.

# ========== Blogger ==========
BLOGGER_BLOG_ID=
BLOGGER_BLOG_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# OAuth refresh token = blogger_token.json 파일로 별도 보관 (TOKEN_PATH 참조)
TOKEN_PATH=C:\AI_X1_Pro_SETUP\blog_pipeline\blogger_token.json

# ========== GitHub ==========
GITHUB_USERNAME=
GITHUB_REPO_URL=
GITHUB_TOKEN=

# ========== 쿠팡 (월/화 채널 승인 후 채움) ==========
COUPANG_AFFILIATE_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ========== 로컬 ollama ==========
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_KR=sg4nt:latest
OLLAMA_MODEL_KR_BIG=qwen36-file:latest
OLLAMA_MODEL_EN=ceont:latest

# ========== 외부 무료 LLM 폴백 (비상시만, .env.keys 에서 자동 로드) ==========
# Z:\docker\.env.keys 에 이미 있는 키 자동 로드:
#   CEREBRAS_KEY / GROQ_KEY / SAMBANOVA_API_KEY / CF_AI_TOKEN / GOOGLE_API_KEY
ENV_KEYS_PATH=Z:\docker\.env.keys

# ========== ComfyUI (사용자 1회 셋업 후 채움) ==========
COMFYUI_HOST=http://127.0.0.1:8188
COMFYUI_ENABLED=false

# ========== 텔레그램 알림 (사용자 trading 봇 재사용) ==========
TELEGRAM_BOT_TOKEN=
TELEGRAM_BLOG_CHAT_ID=
# 비어있으면 알림 SKIP, 시스템 정상 작동.

# ========== 발행 정책 ==========
PUBLISH_DAILY_COUNT=1
QUALITY_GATE_MIN_SCORE=6
QUALITY_GATE_MAX_AI_RATIO=70
DRY_RUN=false

# ========== vault 저장 ==========
VAULT_DIR=C:\docker\obsidian\vault\블로그_수익
